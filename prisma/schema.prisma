// Prisma schema for CollabFlow
// Uses NextAuth.js compatible schema + Document + Kanban models
// Prisma 7 - datasource URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js required models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for credentials auth
  
  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  boards        Board[]
  documentEdits DocumentHistory[]
  
  // Workspace relations
  ownedWorkspaces    Workspace[]       @relation("OwnedWorkspaces")
  workspaceMemberships WorkspaceMember[]
  
  // Chat relations
  channelMemberships ChannelMember[]
  messages           Message[]
  reactions          Reaction[]
  
  // Document sharing
  sharedDocuments    DocumentShare[]
  
  // Notifications
  notifications      Notification[]
  
  // Kanban card relations
  assignedCards      Card[]         @relation("AssignedCards")
  cardComments       CardComment[]  @relation("CardCommentAuthor")
  
  // Activity tracking
  activities         Activity[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notification system
model Notification {
  id        String   @id @default(cuid())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // "workspace_invite", "mention", "task_assigned", "document_shared", "new_message"
  title     String
  message   String?
  link      String?  // URL to navigate to
  
  // Optional references
  workspaceId String?
  senderId    String?  // Who triggered the notification
  
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([userId, isRead])
}

// Workspace - top-level container for team collaboration
model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  
  ownerId     String
  owner       User     @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  
  members     WorkspaceMember[]
  documents   Document[]
  boards      Board[]
  channels    Channel[]
  activities  Activity[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ownerId])
}

// Workspace membership with roles
model WorkspaceMember {
  id          String   @id @default(cuid())
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role        String    @default("member") // owner, admin, member, viewer
  
  joinedAt    DateTime  @default(now())
  
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  
  @@unique([identifier, token])
}

// CollabFlow specific models
model Document {
  id        String   @id @default(cuid())
  title     String   @default("Untitled Document")
  content   String?  @db.Text  // HTML content
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  isPublic  Boolean  @default(false)
  
  history   DocumentHistory[]
  shares    DocumentShare[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([authorId])
  @@index([workspaceId])
}

// Document edit history
model DocumentHistory {
  id          String   @id @default(cuid())
  
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action      String   // "created", "edited", "renamed"
  details     String?  // e.g., "Changed title from X to Y"
  
  createdAt   DateTime @default(now())
  
  @@index([documentId])
  @@index([userId])
}

// Document sharing permissions
model DocumentShare {
  id          String   @id @default(cuid())
  
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permission  String   @default("view") // "view" or "edit"
  
  createdAt   DateTime @default(now())
  
  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// Kanban models
model Board {
  id        String   @id @default(cuid())
  title     String   @default("Untitled Board")
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  columns   Column[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([authorId])
  @@index([workspaceId])
}

model Column {
  id      String @id @default(cuid())
  title   String
  order   Int    @default(0)
  
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  
  cards   Card[]
  
  @@index([boardId])
}

model Card {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  order       Int     @default(0)
  
  // Enhanced fields for Kanban improvements
  priority    String  @default("medium") // "low" | "medium" | "high"
  dueDate     DateTime?
  
  // Assignee (single user for simplicity)
  assigneeId  String?
  assignee    User?   @relation("AssignedCards", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  // Relations for collaboration
  comments    CardComment[]
  checklist   ChecklistItem[]
  
  columnId    String
  column      Column  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([columnId])
  @@index([assigneeId])
}

// Card comments for collaboration
model CardComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation("CardCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([cardId])
  @@index([authorId])
}

// Checklist items within a card
model ChecklistItem {
  id        String  @id @default(cuid())
  content   String
  completed Boolean @default(false)
  order     Int     @default(0)
  
  cardId    String
  card      Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([cardId])
}

// Chat models
model Channel {
  id        String    @id @default(cuid())
  name      String
  type      String    @default("public") // public, private, direct
  
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  members   ChannelMember[]
  messages  Message[]
  
  createdById String?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([workspaceId])
}

model ChannelMember {
  id        String   @id @default(cuid())
  
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role      String   @default("member") // admin, member
  
  joinedAt  DateTime @default(now())
  
  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  attachments Json? // Array of { type: 'image', url: '...' }
  
  // Edit/Delete tracking
  isEdited    Boolean  @default(false)
  editedAt    DateTime?
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  reactions Reaction[]
  
  createdAt DateTime @default(now())
  
  @@index([channelId])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// Activity Feed - tracks team actions for dashboard
model Activity {
  id          String   @id @default(cuid())
  
  // Who did the action
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Which workspace
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Activity type and details
  type        String   // "card_created", "card_moved", "card_completed", "document_created", "document_edited", "member_joined", "message_sent"
  action      String   // Human-readable: "created a card", "moved card to Done", etc.
  
  // Referenced entity (optional)
  entityType  String?  // "card", "document", "channel", "board"
  entityId    String?
  entityTitle String?  // Snapshot of title at time of activity
  
  // Extra metadata as JSON
  metadata    Json?    // { oldColumn: "Todo", newColumn: "Done" }
  
  createdAt   DateTime @default(now())
  
  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, createdAt])
}
