// Prisma schema for CollabFlow
// Uses NextAuth.js compatible schema + Document + Kanban models
// Prisma 7 - datasource URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth.js required models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // Hashed password for credentials auth

  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  boards        Board[]
  documentEdits DocumentHistory[]

  // Workspace relations
  ownedWorkspaces      Workspace[]       @relation("OwnedWorkspaces")
  workspaceMemberships WorkspaceMember[]

  // Chat relations
  channelMemberships ChannelMember[]
  messages           Message[]
  reactions          Reaction[]

  // Document sharing
  sharedDocuments DocumentShare[]
  starredDocuments DocumentStar[]

  // Notifications
  notifications Notification[]

  // Kanban card relations
  assignedCards Card[]        @relation("AssignedCards")
  cardComments  CardComment[] @relation("CardCommentAuthor")

  // Activity tracking
  activities Activity[]

  // Presence
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ... (skipping unchanged models)

model Message {
  id          String @id @default(cuid())
  
  // Idempotency key (optional to allow migration of old messages, or backfill)
  // Making it unique but optional for existing data compatibility, or enforce?
  // User wants production grade. Let's make it optional for migration safe, but code will enforce.
  // Actually, @unique requires unique values. Nulls are unique in Postgres? Yes.
  clientId    String? @unique 
  
  content     String @db.Text
  attachments Json? // Array of { type: 'image', url: '...' }

  // Edit/Delete tracking
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Pinned - REMOVED (moved to PinnedMessage)
  // isPinned Boolean @default(false)
  // pinnedAt DateTime?
  // We keep it temporarily if migration fails, but plan says REMOVE.
  // I will comment it out or remove it.
  
  // Threading support
  parentId    String?
  rootId      String? // Top-level message ID for flat threading
  
  parent      Message?   @relation("MessageThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies     Message[]  @relation("MessageThread")
  replyCount  Int        @default(0)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reactions Reaction[]
  pinnedMessage PinnedMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Added updatedAt for consistency

  @@index([channelId])
  @@index([authorId])
  @@index([parentId])
  @@index([rootId])
}

// Notification system
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // "workspace_invite", "mention", "task_assigned", "document_shared", "new_message"
  title   String
  message String?
  link    String? // URL to navigate to

  // Optional references
  workspaceId String?
  senderId    String? // Who triggered the notification

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// Workspace - top-level container for team collaboration
model Workspace {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  isPublic    Boolean @default(false) // Public workspaces can be discovered and joined

  ownerId String
  owner   User   @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)

  members    WorkspaceMember[]
  documents  Document[]
  boards     Board[]
  channels   Channel[]
  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isPublic])
}

// Workspace membership with roles
model WorkspaceMember {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String @default("member") // owner, admin, member, viewer

  joinedAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// CollabFlow specific models
model Document {
  id       String  @id @default(cuid())
  title    String  @default("Untitled Document")
  content  String? @db.Text // HTML content
  yjsState Bytes?  // Persisted Yjs CRDT state for crash recovery & late-join sync

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  isPublic Boolean @default(false)

  history DocumentHistory[]
  shares  DocumentShare[]
  stars   DocumentStar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([workspaceId])
}

// Document edit history
model DocumentHistory {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action   String // "created", "edited", "renamed"
  details  String? // e.g., "Changed title from X to Y"
  snapshot String? @db.Text // Content at this point in time

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

// Document sharing permissions
model DocumentShare {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission String @default("view") // "view" or "edit"

  createdAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

// Kanban models
model Board {
  id    String @id @default(cuid())
  title String @default("Untitled Board")

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  columns Column[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([workspaceId])
}

model Column {
  id       String @id @default(cuid())
  title    String
  order    Int    @default(0)
  orderKey String @default("a0") // Fractional index for concurrent-safe ordering

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  @@index([boardId])
}

model Card {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  order       Int     @default(0)
  orderKey    String  @default("a0") // Fractional index for concurrent-safe ordering

  // Enhanced fields for Kanban improvements
  priority  String    @default("medium") // "low" | "medium" | "high"
  dueDate   DateTime?
  startDate DateTime?
  labels    String[]  @default([])
  status    String    @default("active") // "active" | "completed" | "archived"

  // Assignee (single user for simplicity)
  assigneeId String?
  assignee   User?   @relation("AssignedCards", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Relations for collaboration
  comments  CardComment[]
  checklist ChecklistItem[]

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
  @@index([assigneeId])
}

// Card comments for collaboration
model CardComment {
  id      String @id @default(cuid())
  content String @db.Text

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CardCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([authorId])
}

// Checklist items within a card
model ChecklistItem {
  id        String  @id @default(cuid())
  content   String
  completed Boolean @default(false)
  order     Int     @default(0)
  orderKey  String  @default("a0") // Fractional index for concurrent-safe ordering

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId])
}

// Chat models
model Channel {
  id          String  @id @default(cuid())
  name        String
  description String? // Channel topic/description
  type        String  @default("public") // public, private, direct

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members  ChannelMember[]
  messages Message[]

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model ChannelMember {
  id String @id @default(cuid())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       String    @default("member") // admin, member
  lastReadAt DateTime? // For unread message tracking

  joinedAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}



model Reaction {
  id    String @id @default(cuid())
  emoji String

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// Starred/Favorite Documents
model DocumentStar {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([userId])
  @@index([documentId])
}

// Check Pinned Messages
model PinnedMessage {
  id        String   @id @default(cuid())
  messageId String   @unique
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedBy  String   // User ID who pinned it
  pinnedAt  DateTime @default(now())

  // Denormalize channelId for easier filtering if needed, or rely on message
  // Let's rely on message.channelId for now to avoid sync issues.
}

// Activity Feed - tracks team actions for dashboard
model Activity {
  id String @id @default(cuid())

  // Who did the action
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which workspace
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Activity type and details
  type   String // "card_created", "card_moved", "card_completed", "document_created", "document_edited", "member_joined", "message_sent"
  action String // Human-readable: "created a card", "moved card to Done", etc.

  // Referenced entity (optional)
  entityType  String? // "card", "document", "channel", "board"
  entityId    String?
  entityTitle String? // Snapshot of title at time of activity

  // Extra metadata as JSON
  metadata Json? // { oldColumn: "Todo", newColumn: "Done" }

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, createdAt])
}
